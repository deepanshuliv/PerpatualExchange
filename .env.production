# Production Environment Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=postgres

# Database URL pointing to internal docker network
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@postgres:5432/postgres

# Redis URL pointing to internal docker network
REDIS_URL=redis://redis:6379

# JWT Authentication Secret (Generate a random 32+ char string)
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_in_production

# Redis stream configurations
ENGINE_STREAM=to-engine
BACKEND_STREAM=to-backend
WS_CONSUMER_GROUP=ws-group
WS_CONSUMER_NAME=ws
DB_CONSUMER_GROUP=db-consumer-group
DB_CONSUMER_NAME=db-consumer

# Binance Live Futures Stream
BINANCE_STREAM_URL=wss://stream.binancefuture.com/stream?streams=btcusdt@markPrice@1s/solusdt@markPrice@1s/ethusdt@markPrice@1s

# Market Maker Settings
MM_INITIAL_BALANCE=1000000
MM_MIN_BALANCE=100000
MM_REQUOTE_INTERVAL_MS=1000
