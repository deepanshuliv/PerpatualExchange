# Template for /opt/apps/perp/.env on the shared VM (chmod 600).
# Used by docker-compose.prod.yml; local dev uses .env.example instead.

POSTGRES_USER=perp
POSTGRES_PASSWORD=
POSTGRES_DB=perp

JWT_SECRET=
JWT_EXPIRES_IN=7d
# Keep false in production: these routes mint funded users and move the mark price.
ENABLE_SIM_ROUTES=false
CORS_ORIGINS=https://axiom.deepanshu.live,https://perp.deepanshu.live,https://perp.35.226.245.19.sslip.io

# Baked in at build time. Leave empty to use same-origin /api and wss://<host>/ws,
# so the image works on every hostname without a rebuild.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

GATEWAY_PORT=8090

BINANCE_STREAM_URL=wss://stream.binancefuture.com/stream?streams=btcusdt@markPrice@1s/solusdt@markPrice@1s/ethusdt@markPrice@1s

# Cloudflare R2: engine snapshots, history archive and daily pg_dump backups.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Storage bounds
REDIS_MAXMEMORY=512mb
HISTORY_RETENTION_DAYS=90
ARCHIVE_BACKFILL_DAYS=25
BACKUP_KEEP_DAYS=14
DISK_WARN_PERCENT=80
ENGINE_MAX_IN_MEMORY_FILLS=100000
ENGINE_MAX_OPEN_ORDERS=100000
WS_MAX_CLIENTS=1000
WS_MAX_BUFFERED_BYTES=4194304
BACKEND_MAX_PENDING_REQUESTS=10000

MM_INITIAL_BALANCE=1000000
MM_MIN_BALANCE=100000
MM_REQUOTE_INTERVAL_MS=1000
