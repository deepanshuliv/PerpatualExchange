{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "apps/frontend/.next/**", "apps/*/.next/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "CORS_ORIGINS",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_WS_URL",
        "ENGINE_STREAM",
        "BACKEND_STREAM",
        "WS_CONSUMER_GROUP",
        "WS_CONSUMER_NAME",
        "DB_CONSUMER_GROUP",
        "DB_CONSUMER_NAME",
        "BACKEND_MAX_PENDING_REQUESTS",
        "BINANCE_STREAM_URL",
        "SNAPSHOT_DIR",
        "ENGINE_MAX_IN_MEMORY_FILLS",
        "ENGINE_MAX_OPEN_ORDERS",
        "WS_MAX_CLIENTS",
        "WS_MAX_BUFFERED_BYTES",
        "HISTORY_RETENTION_DAYS",
        "MM_INITIAL_BALANCE",
        "MM_MIN_BALANCE",
        "MM_BALANCE_CHECK_INTERVAL_MS",
        "MM_REQUOTE_INTERVAL_MS",
        "PORT",
        "HOST",
        "R2_ENDPOINT",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME"
      ]
    }
  }
}
