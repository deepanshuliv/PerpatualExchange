# One production image for every Bun service and the Next.js frontend.
# docker-compose.prod.yml picks the process with `command:`.
FROM oven/bun:1.3.13
WORKDIR /app

# Baked into the browser bundle. The defaults are relative, so the same image
# works on any hostname: the API is same-origin /api and the WebSocket URL is
# derived from window.location (see apps/frontend/app/hooks/useApi.ts).
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_WS_URL=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_TELEMETRY_DISABLED=1

# Manifests first, so the install layer is reused when only source changes.
# A new workspace needs its package.json listed here.
COPY package.json bun.lock turbo.json ./
COPY apps/backend/package.json apps/backend/
COPY apps/db/package.json apps/db/
COPY apps/engine/package.json apps/engine/
COPY apps/frontend/package.json apps/frontend/
COPY apps/market-maker/package.json apps/market-maker/
COPY apps/ws/package.json apps/ws/
COPY packages/db/package.json packages/db/
COPY packages/redis/package.json packages/redis/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/types/package.json packages/types/
COPY packages/typescript-config/package.json packages/typescript-config/

# Not --frozen-lockfile: every package depends on "@types/bun": "latest", so a
# frozen install fails whenever a new @types/bun is published. Only that
# types-only entry moves; everything else resolves from bun.lock.
RUN bun install

COPY packages ./packages
COPY apps ./apps

RUN cd packages/db && bun run prisma generate
RUN cd apps/frontend && bun run build && rm -rf .next/cache

ENV NODE_ENV=production

CMD ["bun", "apps/engine/index.ts"]
