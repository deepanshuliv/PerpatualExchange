
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@postgres:5432/postgres

REDIS_URL=redis://redis:6379

JWT_SECRET=your_random_jwt_secret_here
# Session lifetime, in jsonwebtoken format ("7d", "12h", ...).
JWT_EXPIRES_IN=7d
# /sim/provision and /sim/inject-mark-price mint funded users and move the mark
# price (which liquidates real positions). Keep false on any public deployment.
ENABLE_SIM_ROUTES=false
CORS_ORIGINS=https://exchange.deepanshu.live,http://localhost:3000

NEXT_PUBLIC_API_URL=https://exchange.deepanshu.live/api
NEXT_PUBLIC_WS_URL=wss://exchange.deepanshu.live/ws

ENGINE_STREAM=to-engine
BACKEND_STREAM=to-backend
WS_CONSUMER_GROUP=ws-group
WS_CONSUMER_NAME=ws
DB_CONSUMER_GROUP=db-consumer-group
DB_CONSUMER_NAME=db-consumer
BACKEND_MAX_PENDING_REQUESTS=10000

BINANCE_STREAM_URL=wss://stream.binancefuture.com/stream?streams=btcusdt@markPrice@1s/solusdt@markPrice@1s/ethusdt@markPrice@1s

MM_INITIAL_BALANCE=1000000
MM_MIN_BALANCE=100000
MM_REQUOTE_INTERVAL_MS=1000

# Storage safety. R2 is optional; the engine always checkpoints to its Docker volume.
ENGINE_MAX_IN_MEMORY_FILLS=100000
ENGINE_MAX_OPEN_ORDERS=100000
HISTORY_RETENTION_DAYS=90
WS_MAX_CLIENTS=1000
WS_MAX_BUFFERED_BYTES=4194304
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=perp-exchange-snapshots
