# Database Connection (TimescaleDB on PostgreSQL 15)
DATABASE_URL=postgresql://postgres:mypassword@localhost:5432/postgres

# Redis Connection
REDIS_URL=redis://localhost:6379

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_here

# Redis stream name for matching engine requests
ENGINE_STREAM=to-engine

# Redis stream name for backend updates
BACKEND_STREAM=to-backend

# WebSocket consumer configuration
WS_CONSUMER_GROUP=ws-group
WS_CONSUMER_NAME=ws

# DB consumer configuration
DB_CONSUMER_GROUP=db-consumer-group
DB_CONSUMER_NAME=db-consumer

# Binance mark price WebSocket stream URL
BINANCE_STREAM_URL=wss://stream.binancefuture.com/stream?streams=btcusdt@markPrice@1s/solusdt@markPrice@1s/ethusdt@markPrice@1s
