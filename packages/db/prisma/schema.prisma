generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Kind {
  LONG
  SHORT
}

enum Type {
  LIMIT
  MARKET
  LIQUIDATION
}

enum Status {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum Market {
  BTCUSD
  ETHUSD
  SOLUSD
  USD
}

model user {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  orders    order[]
  buyFills  fill[]   @relation("BuyerFills")
  sellFills fill[]   @relation("SellerFills")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model order {
  id              String   @id
  userId          String
  user            user     @relation(fields: [userId], references: [id])
  type            Type
  totalQty        Float
  filledQty       Float
  price           Float
  status          Status
  margin          Float
  kind            Kind
  market          Market
  fills           fill[]
  transactionTime DateTime @default(now())
  createdAt       DateTime @default(now())
}

model fill {
  id              String   @id 
  orderId         String
  order           order    @relation(fields: [orderId], references: [id])
  buyerId         String
  buyer           user     @relation("BuyerFills", fields: [buyerId], references: [id])
  sellerId        String
  seller          user     @relation("SellerFills", fields: [sellerId], references: [id])
  price           Float
  qty             Float
  type            Type
  kind            Kind
  status          Status
  transactionTime DateTime 
  createdAt       DateTime @default(now())
}


model market {
  id       String @id @default(uuid())
  slug     String
  imageUrl String
}

model tick {
  id     Int      @default(autoincrement())
  time   DateTime @default(now())
  market Market
  price  Float
  volume Float

  @@id([time, id])
  @@index([market, time])
  @@map("ticks")
}

model candle1m {
  openTime DateTime
  market   Market
  open     Float
  high     Float
  low      Float
  close    Float
  volume   Float

  @@id([openTime, market])
  @@index([market, openTime])
  @@map("candles_1m")
}

