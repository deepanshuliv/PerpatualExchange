exchange.deepanshu.live {
    handle /api {
        uri strip_prefix /api
        reverse_proxy backend:3001
    }

    # Strip /api before forwarding because the Express routes are rooted at /.
    handle_path /api/* {
        reverse_proxy backend:3001
    }

    handle /ws* {
        reverse_proxy ws:8080
    }

    handle {
        reverse_proxy frontend:3000
    }
}

exchange-api.deepanshu.live {
    handle /ws* {
        reverse_proxy ws:8080
    }

    handle {
        reverse_proxy backend:3001
    }
}
